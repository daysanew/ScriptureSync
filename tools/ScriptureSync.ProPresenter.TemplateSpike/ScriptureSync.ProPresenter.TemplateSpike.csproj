    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ScriptureSync.ProPresenter.BibleSpike/ScriptureSync.ProPresenter.BibleSpike.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
    <Protobuf Include="Schemas/*.proto" ProtoRoot="Schemas" GrpcServices="None" />
  </ItemGroup>
</Project>
