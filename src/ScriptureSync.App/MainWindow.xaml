<Window x:Class="ScriptureSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scripture Sync"
        Height="680"
        Width="1020"
        MinHeight="580"
        MinWidth="850"
        Loaded="MainWindow_Loaded"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="#18212F" Text="Scripture Sync" />
                <TextBlock Margin="0,5,0,0"
                       FontSize="15"
                       Foreground="#5D6878"
                       Text="Review and prepare scripture before sending it to OpenLP." />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="92" Height="36"
                    Click="Settings_Click" Content="Settings" />
        </Grid>

        <Border Grid.Row="2" Padding="18" Background="White" CornerRadius="9">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#5D6878" Text="OPENLP" />
                <TextBlock Margin="0,5,0,0" FontSize="15" Foreground="#283444"
                           Text="{Binding OpenLpStatus}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel>
            <Button Width="118" Height="38" Margin="0,0,8,8"
                    Command="{Binding AddCommand}" Content="Add Scripture" />
            <Button Width="126" Height="38" Margin="0,0,8,8" Click="PasteScriptures_Click"
                    Content="Paste Scriptures" />
            <Button Width="146" Height="38" Margin="0,0,26,8"
                    Click="ImportPlanningCenter_Click" Content="Import from PCO" />
            <Button Width="80" Height="38" Margin="0,0,8,8"
                    Command="{Binding DuplicateCommand}" Content="Duplicate" />
            <Button Width="74" Height="38" Margin="0,0,8,8"
                    Command="{Binding RemoveCommand}" Content="Remove" />
            <Button Width="66" Height="38" Margin="0,0,8,8"
                    Command="{Binding MoveUpCommand}" Content="Move ↑" />
            <Button Width="72" Height="38" Margin="0,0,8,8"
                    Command="{Binding MoveDownCommand}" Content="Move ↓" />
            <Button Width="82" Height="38" Margin="8,0,0,8"
                    Click="ClearAll_Click"
                    Background="#FFF0F0"
                    Foreground="#8A2020"
                    Content="Clear All" />
            </WrapPanel>
            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Right"
                       Margin="0,0,0,2"
                       FontWeight="SemiBold"
                       Foreground="#4B5869"
                       Text="{Binding SummaryText}" />
        </Grid>

        <Border Grid.Row="6" Background="White" CornerRadius="9" BorderBrush="#DDE2E9" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2.1*"
                                        Header="Scripture and translation"
                                        Binding="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="1.6*" Header="Parsed as" IsReadOnly="True" Binding="{Binding NormalizedText}" />
                    <DataGridTextColumn Width="1.7*" Header="Status" IsReadOnly="True" Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="8">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="#5D6878" Text="Draft changes are saved automatically on this computer." />
                <TextBlock Margin="0,3,0,0" Foreground="#5D6878"
                           Text="OpenLP must be running on this computer before syncing." />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Width="188"
                    Height="48"
                    Command="{Binding SyncCommand}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Content="{Binding SyncButtonText}" />
        </Grid>
    </Grid>
</Window>
