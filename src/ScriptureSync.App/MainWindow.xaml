<Window x:Class="ScriptureSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scripture Sync"
        Height="680"
        Width="1020"
        MinHeight="580"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="#18212F" Text="Scripture Sync" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="#5D6878"
                           Text="Review and prepare scripture before sending it to OpenLP." />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    Background="#FFF4D6"
                    CornerRadius="6">
                <TextBlock Foreground="#765900" Text="Manual testing mode" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="18" Background="White" CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#5D6878" Text="SOURCE" />
                    <TextBlock Margin="0,5,0,0" FontSize="15" Foreground="#283444" Text="Manual draft" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#5D6878" Text="PLANNING CENTER" />
                    <TextBlock Margin="0,5,0,0" FontSize="15" Foreground="#283444" Text="Not connected yet" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#5D6878" Text="OPENLP SYNC" />
                    <TextBlock Margin="0,5,0,0" FontSize="15" Foreground="#283444"
                               Text="{Binding OpenLpStatus}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="118" Height="38" Margin="0,0,8,0"
                    Command="{Binding AddCommand}" Content="Add Scripture" />
            <Button Grid.Column="1" Width="126" Height="38" Click="PasteScriptures_Click"
                    Content="Paste Scriptures" />
            <Button Grid.Column="3" Width="80" Height="38" Margin="0,0,8,0"
                    Command="{Binding DuplicateCommand}" Content="Duplicate" />
            <Button Grid.Column="4" Width="74" Height="38" Margin="0,0,8,0"
                    Command="{Binding RemoveCommand}" Content="Remove" />
            <Button Grid.Column="5" Width="66" Height="38" Margin="0,0,8,0"
                    Command="{Binding MoveUpCommand}" Content="Move ↑" />
            <Button Grid.Column="6" Width="72" Height="38"
                    Command="{Binding MoveDownCommand}" Content="Move ↓" />
            <TextBlock Grid.Column="8"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#4B5869"
                       Text="{Binding SummaryText}" />
        </Grid>

        <Border Grid.Row="6" Background="White" CornerRadius="9" BorderBrush="#DDE2E9" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2.1*"
                                        Header="Scripture and translation"
                                        Binding="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="0.65*" Header="Source" IsReadOnly="True" Binding="{Binding Source}" />
                    <DataGridTextColumn Width="1.6*" Header="Parsed as" IsReadOnly="True" Binding="{Binding NormalizedText}" />
                    <DataGridTextColumn Width="1.7*" Header="Status" IsReadOnly="True" Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="8">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="#5D6878" Text="Draft changes are saved automatically on this computer." />
                <TextBlock Margin="0,3,0,0" Foreground="#5D6878"
                           Text="OpenLP must be running on this computer before syncing." />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Width="188"
                    Height="48"
                    Command="{Binding SyncCommand}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Content="{Binding SyncButtonText}" />
        </Grid>
    </Grid>
</Window>
