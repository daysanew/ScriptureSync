<Window x:Class="ScriptureSync.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="600" Width="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#18212F" Text="Settings" />
        <TextBlock Grid.Row="2" FontWeight="SemiBold" Foreground="#283444"
                   Text="Default Bible translation" />
        <TextBox x:Name="DefaultTranslationTextBox" Grid.Row="4" Height="36"
                 Padding="9,6" MaxLength="15" CharacterCasing="Upper" />
        <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="#5D6878" TextWrapping="Wrap"
                   Text="Used when a scripture has no translation, such as John 3:16. Explicit translations always take priority." />
        <StackPanel Grid.Row="7">
            <TextBlock FontWeight="SemiBold" Foreground="#283444"
                       Text="Planning Center Personal Access Token" />
            <TextBlock Margin="0,5,0,0" Foreground="#5D6878" TextWrapping="Wrap">
                An organization administrator must create the token.
                <Hyperlink NavigateUri="https://api.planningcenteronline.com"
                           RequestNavigate="PlanningCenterDeveloperLink_RequestNavigate">Open the Planning Center developer account</Hyperlink>
                to create one.
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Foreground="#5D6878" Text="Application ID" />
                <TextBox x:Name="PlanningCenterApplicationIdTextBox" Height="36" Margin="0,5,0,0" Padding="9,6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Foreground="#5D6878" Text="Secret" />
                <PasswordBox x:Name="PlanningCenterSecretPasswordBox" Height="36" Margin="0,5,0,0" Padding="9,6" />
                <TextBlock x:Name="SavedCredentialTextBlock" Margin="0,4,0,0"
                           Foreground="#5D6878" FontSize="11" />
                <Button x:Name="RemoveCredentialsButton" Width="148" Height="28" Margin="0,6,0,0"
                        HorizontalAlignment="Left" Click="RemoveCredentials_Click"
                        Content="Remove saved token" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="11" FontWeight="SemiBold" Foreground="#283444"
                   Text="Service item names" />
        <TextBox x:Name="PlanningCenterItemNamesTextBox" Grid.Row="13" Height="82"
                 Padding="9,6" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        <TextBlock Grid.Row="14" Margin="0,8,0,0" Foreground="#5D6878" TextWrapping="Wrap"
                   Text="Enter one exact item name per line. Scripture references are imported from the Details field of every matching item." />
        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Width="82" Height="36" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
            <Button Width="82" Height="36" IsDefault="True" Click="Save_Click" Content="Save" />
        </StackPanel>
    </Grid>
</Window>
