<Window x:Class="ScriptureSync.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="320" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#18212F" Text="Settings" />
        <TextBlock Grid.Row="2" FontWeight="SemiBold" Foreground="#283444"
                   Text="Default Bible translation" />
        <TextBox x:Name="DefaultTranslationTextBox" Grid.Row="4" Height="36"
                 Padding="9,6" MaxLength="15" CharacterCasing="Upper" />
        <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="#5D6878" TextWrapping="Wrap"
                   Text="Used when a scripture has no translation, such as John 3:16. Explicit translations always take priority." />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="82" Height="36" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
            <Button Width="82" Height="36" IsDefault="True" Click="Save_Click" Content="Save" />
        </StackPanel>
    </Grid>
</Window>
